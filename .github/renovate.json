{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>openshift/boilerplate//.github/renovate.json"
  ],
  "packageRules": [
    {
      "description": "Hold kube-openapi until Go 1.27 is supported by the build image",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "k8s.io/kube-openapi"
      ],
      "enabled": false
    }
  ],
  "dockerfile": {
    "includePaths": [
      "build/Dockerfile",
      "build/Dockerfile.hummingbird"
    ],
    "packageRules": [
      {
        "description": "Review Hummingbird runtime digest updates before merging",
        "matchPackageNames": [
          "registry.access.redhat.com/hi/core-runtime"
        ],
        "matchUpdateTypes": [
          "digest"
        ],
        "automerge": false,
        "platformAutomerge": false
      }
    ]
  }
}
